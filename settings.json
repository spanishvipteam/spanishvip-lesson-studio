{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__figma",
      "mcp__canva",
      "Read(lessons/**)",
      "Read(assets/**)",
      "Read(docs/**)",
      "Edit(lessons/*/output/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(lessons/*/source/**)",
      "Edit(assets/branding/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
